---
/**
 * /tradingweb/frontend/src/layouts/DashboardLayout.astro
 * DashboardLayout — MarketPulse Shell
 * ======================================
 * Wraps all dashboard pages with:
 *   - Fixed sidebar (left)
 *   - Fixed topbar (top)
 *   - Scrollable main content area
 *   - Google Fonts (Space Grotesk + DM Sans)
 *   - Tailwind dark mode class on <html>
 *   - Auth store integration (JWT)
 */

import Sidebar from '../components/dashboard/Sidebar.astro';
import Topbar from '../components/dashboard/Topbar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'MarketPulse — Options Analysis' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" x-data="dashboard()" x-init="init()" :class="{ 'dark': darkMode }" class="h-full" x-cloak>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Real-time Futures Trading Signals based on Options Data" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Space Grotesk (display) + DM Sans (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Alpine.js + Stores: loaded as ES module via script tag -->
    <script>
      // Import stores
      import { createDashboardStore } from '../stores/dashboard.ts';
      import { createAuthStore } from '../stores/authStore.ts';

      // Initialize stores
      const store = createDashboardStore();
      const authStore = createAuthStore();

      // Global helper to access auth store from components
      function getAlpineStore() {
        return {
          getAuthStore: () => authStore,
        };
      }

      // Expose to Alpine.js as global data functions
      document.addEventListener('alpine:init', () => {
        // Dashboard store (primary — set on <html> via x-data="dashboard()")
        (window as any).Alpine.data('dashboard', () => store);

        // Auth store (secondary — available as `auth` in components)
        (window as any).Alpine.data('auth', () => authStore);

        // Global helper
        (window as any).getAlpineStore = getAlpineStore;
      });

      // Auto-init auth on page load (validates existing tokens)
      authStore.init();

      // Cleanup on page navigation
      document.addEventListener('astro:before-swap', () => {
        store.destroy();
      });
    </script>
  </head>

  <body class="h-full">
    <!-- Sidebar (fixed, z-50) -->
    <Sidebar />

    <!-- Topbar (fixed, z-40) -->
    <Topbar />

    <!-- Scrollable main content -->
    <main
      class="ml-[228px] mt-[52px] dash-scroll overflow-y-auto transition-colors duration-300"
      style="height: calc(100vh - 52px)"
    >
      <slot />
    </main>

    <!-- ═══════════════════════════════════════════════════════
         GLOBAL TOOLTIP PANEL
         Lives at body level — survives all Alpine re-renders.
         Positioning is computed from the hovered element's
         getBoundingClientRect(), stored in tip.posX / tip.posY.
         ═══════════════════════════════════════════════════════ -->
    <div
      x-show="tip.visible && tip.data"
      x-transition:enter="transition ease-out duration-150"
      x-transition:enter-start="opacity-0 scale-95"
      x-transition:enter-end="opacity-100 scale-100"
      x-transition:leave="transition ease-in duration-100"
      x-transition:leave-start="opacity-100 scale-100"
      x-transition:leave-end="opacity-0 scale-95"
      x-cloak
      class="fixed z-[9999] pointer-events-none"
      :style="tip.dir === 'below'
        ? 'left:' + tip.posX + 'px; top:' + tip.posY + 'px; transform: translate(-50%, 8px);'
        : 'left:' + tip.posX + 'px; top:' + tip.posY + 'px; transform: translate(-50%, -100%) translateY(-8px);'"
      @mouseenter="if(_tipHideTimer){clearTimeout(_tipHideTimer);_tipHideTimer=null;}"
      @mouseleave="hideTooltip()"
    >
      <div class="bg-gray-900 dark:bg-gray-800 rounded-lg shadow-2xl border border-gray-700/60 px-4 py-3 w-[300px] max-w-[85vw] pointer-events-auto">
        <p class="text-[11px] font-bold text-white mb-1.5 tracking-wide" x-text="tip.title"></p>

        <!-- Calculation section -->
        <template x-if="tip.data?.calculation">
          <div class="mb-2">
            <p class="text-[9px] uppercase tracking-[.15em] font-semibold text-sky-400 mb-0.5">Calculation</p>
            <p class="text-[10px] text-gray-300 leading-relaxed" x-text="tip.data.calculation"></p>
          </div>
        </template>

        <!-- Description section -->
        <template x-if="tip.data?.description">
          <p class="text-[10px] text-gray-300 leading-relaxed mb-2" x-text="tip.data.description"></p>
        </template>

        <!-- Impact section -->
        <template x-if="tip.data?.impact">
          <div class="mb-2">
            <p class="text-[9px] uppercase tracking-[.15em] font-semibold text-amber-400 mb-0.5">Impact</p>
            <p class="text-[10px] text-gray-300 leading-relaxed" x-text="tip.data.impact"></p>
          </div>
        </template>

        <!-- Action section -->
        <template x-if="tip.data?.action">
          <div>
            <p class="text-[9px] uppercase tracking-[.15em] font-semibold text-emerald-400 mb-0.5">Action</p>
            <p class="text-[10px] text-gray-300 leading-relaxed" x-text="tip.data.action"></p>
          </div>
        </template>
      </div>
    </div>
  </body>
</html>
