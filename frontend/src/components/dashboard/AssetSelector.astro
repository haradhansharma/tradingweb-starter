---
/**
 * tradingweb/frontend/src/components/dashboard/AssetSelector.astro
 * AssetSelector — Filter buttons for underlyings
 * ================================================
 * Horizontal row of clickable buttons: "All Assets" + one per underlying.
 * Active state is emerald. Dot color reflects decision signal.
 */
---

<section
  class="flex items-center gap-2 flex-wrap"
  role="tablist"
  aria-label="Select asset to analyze"
>
  <!-- "All Assets" button -->
  <button
    @click="selectAsset(null)"
    role="tab"
    :aria-selected="selectedAsset === null"
    class="asset-select-btn shrink-0 px-4 py-2 rounded-lg text-[13px] font-semibold"
    :class="selectedAsset === null
      ? 'bg-emerald-500 text-white shadow-sm shadow-emerald-500/20'
      : 'bg-white dark:bg-surface-700 border border-gray-200 dark:border-surface-300 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:border-gray-300 dark:hover:border-surface-100'"
  >
    All Assets
  </button>

  <!-- Per-asset buttons -->
  <template x-for="a in assetList" :key="a.symbol">
    <button
      @click="selectAsset(a.symbol)"
      role="tab"
      :aria-selected="selectedAsset === a.symbol"
      class="asset-select-btn shrink-0 flex items-center gap-2 px-4 py-2 rounded-lg text-[13px] font-semibold"
      :class="selectedAsset === a.symbol
        ? 'bg-emerald-500 text-white shadow-sm shadow-emerald-500/20'
        : 'bg-white dark:bg-surface-700 border border-gray-200 dark:border-surface-300 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:border-gray-300 dark:hover:border-surface-100'"
    >
      <!-- Decision dot -->
      <span
        class="w-[7px] h-[7px] rounded-full shrink-0"
        :class="dotColor(a.decision)"
      ></span>
      <!-- Symbol -->
      <span x-text="a.symbol"></span>
      <!-- Change % -->
      <span
        class="text-[11px] font-medium"
        :class="selectedAsset === a.symbol
          ? 'text-emerald-100'
          : (a.change >= 0 ? 'text-emerald-500' : 'text-red-500')"
        x-text="(a.change >= 0 ? '+' : '') + a.change.toFixed(2) + '%'"
      ></span>
    </button>
  </template>
</section>
