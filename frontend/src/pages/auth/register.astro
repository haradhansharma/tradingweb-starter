---
/**
 * Register Page — MarketPulse
 * ============================
 * New user registration with validation.
 * After successful registration, redirects to OTP verification page.
 */
import AuthLayout from '../../layouts/AuthLayout.astro';
---

<AuthLayout title="Create Account — MarketPulse">
  <div x-data="registerForm()" x-init="init()">
    <!-- Logo -->
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-blue-400" style="font-family: 'Space Grotesk', sans-serif;">
        MarketPulse
      </h1>
      <p class="text-sm text-gray-500 mt-1">Create your account</p>
    </div>

    <!-- Error -->
    <div
      x-show="error"
      x-transition
      class="mb-4 p-3 bg-red-900/30 border border-red-800 rounded-lg text-sm text-red-300"
      x-text="error"
    ></div>

    <!-- Form -->
    <form x-show="!success" @submit.prevent="handleRegister()">
      <div class="mb-4">
        <label class="block text-xs font-medium text-gray-400 uppercase tracking-wider mb-1.5">Username</label>
        <input
          type="text"
          x-model="username"
          autocomplete="username"
          required
          minlength="3"
          class="w-full px-3.5 py-2.5 bg-[#0f1117] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500 transition-colors"
          placeholder="Choose a username"
        >
      </div>

      <div class="mb-4">
        <label class="block text-xs font-medium text-gray-400 uppercase tracking-wider mb-1.5">Email</label>
        <input
          type="email"
          x-model="email"
          autocomplete="email"
          required
          class="w-full px-3.5 py-2.5 bg-[#0f1117] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500 transition-colors"
          placeholder="your@email.com"
        >
        <p class="text-[11px] text-gray-500 mt-1">A verification code will be sent to this email</p>
      </div>

      <div class="mb-6">
        <label class="block text-xs font-medium text-gray-400 uppercase tracking-wider mb-1.5">Password</label>
        <input
          type="password"
          x-model="password"
          autocomplete="new-password"
          required
          minlength="8"
          class="w-full px-3.5 py-2.5 bg-[#0f1117] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500 transition-colors"
          placeholder="At least 8 characters"
        >
      </div>

      <button
        type="submit"
        :disabled="loading"
        class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-semibold rounded-lg transition-colors"
      >
        <span x-show="!loading">Create Account</span>
        <span x-show="loading" class="flex items-center justify-center gap-2">
          <svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="32" stroke-dashoffset="32" stroke-linecap="round"/>
          </svg>
          Creating account...
        </span>
      </button>
    </form>

    <!-- Footer -->
    <p class="text-center text-sm text-gray-500 mt-6">
      Already have an account?
      <a href="/auth/login" class="text-blue-400 hover:text-blue-300 ml-1">Sign in</a>
    </p>
  </div>
</AuthLayout>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('registerForm', () => {
      const { getAuthStore } = getAlpineStore();

      return {
        username: '',
        email: '',
        password: '',
        loading: false,
        error: null,
        success: false,

        init() {},

        async handleRegister() {
          this.loading = true;
          this.error = null;

          const auth = getAuthStore();
          const result = await auth.register(this.username, this.email, this.password);

          if (result.success) {
            this.success = true;
            // Redirect to OTP verification page with username
            setTimeout(() => {
              window.location.href = `/auth/verify-otp?username=${encodeURIComponent(this.username)}`;
            }, 500);
          } else {
            this.error = result.error || 'Registration failed.';
            this.loading = false;
          }
        },
      };
    });
  });
</script>
