---
/**
 * Settings Page — MarketPulse
 * =============================
 * Security settings: change password, sign out.
 * Profile and credentials have their own dedicated pages.
 * Requires authentication (DashboardLayout handles guard).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Settings — MarketPulse">
  <div class="p-5 space-y-5 max-w-[900px]">
    <!-- Header -->
    <div>
      <h1 class="text-lg font-semibold text-white" style="font-family: 'Space Grotesk', sans-serif;">Settings</h1>
      <p class="text-xs text-gray-500 mt-0.5">Security and account settings</p>
    </div>

    <!-- Quick Links -->
    <div class="flex gap-3">
      <a href="/profile" class="flex items-center gap-2 px-3 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-xs text-gray-300 hover:text-white hover:border-surface-400 transition-all no-underline">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        Edit Profile
      </a>
      <a href="/credentials" class="flex items-center gap-2 px-3 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-xs text-gray-300 hover:text-white hover:border-surface-400 transition-all no-underline">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
        </svg>
        API Credentials
      </a>
    </div>

    <!-- Change Password Card -->
    <div class="bg-[#1a1d27] border border-[#2a2d3a] rounded-xl p-5" x-data="passwordChanger()">
      <h2 class="text-sm font-semibold text-gray-200 mb-1" style="font-family: 'Space Grotesk', sans-serif;">
        Change Password
      </h2>
      <p class="text-xs text-gray-500 mb-4">Update your account password. You will need to sign in again after changing.</p>

      <div x-show="$store.auth.isAuthenticated">
        <form @submit.prevent="handleChangePassword()">
          <div class="mb-3">
            <label class="block text-xs text-gray-400 mb-1">Current Password</label>
            <input type="password" x-model="currentPassword" required
              class="w-full px-2.5 py-2 bg-[#0f1117] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500"
              placeholder="Enter current password">
          </div>
          <div class="mb-3">
            <label class="block text-xs text-gray-400 mb-1">New Password</label>
            <input type="password" x-model="newPassword" required minlength="8"
              class="w-full px-2.5 py-2 bg-[#0f1117] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500"
              placeholder="At least 8 characters">
          </div>
          <div class="mb-4">
            <label class="block text-xs text-gray-400 mb-1">Confirm New Password</label>
            <input type="password" x-model="confirmPassword" required minlength="8"
              class="w-full px-2.5 py-2 bg-[#0f1117] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500"
              placeholder="Confirm new password">
          </div>

          <div x-show="error" x-text="error" class="mb-3 text-xs text-red-400"></div>
          <div x-show="success" class="mb-3 text-xs text-emerald-400">
            Password changed successfully. You may need to sign in again.
          </div>

          <button
            type="submit"
            :disabled="loading"
            class="px-4 py-2 text-xs font-medium bg-blue-600 hover:bg-blue-700 disabled:opacity-50 text-white rounded-lg transition-colors"
          >
            <span x-show="!loading">Update Password</span>
            <span x-show="loading" class="flex items-center gap-1.5">
              <svg class="w-3 h-3 animate-spin" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-25"></circle>
                <path d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor" class="opacity-75"></path>
              </svg>
              Updating...
            </span>
          </button>
        </form>
      </div>

      <div x-show="!$store.auth.isAuthenticated" class="text-center py-4 text-gray-500 text-sm">
        <p>Please <a href="/auth/login" class="text-blue-400 hover:text-blue-300 no-underline">sign in</a> to change your password.</p>
      </div>
    </div>

    <!-- Sign Out Card -->
    <div class="bg-[#1a1d27] border border-[#2a2d3a] rounded-xl p-5">
      <h2 class="text-sm font-semibold text-gray-200 mb-1" style="font-family: 'Space Grotesk', sans-serif;">
        Sign Out
      </h2>
      <p class="text-xs text-gray-500 mb-4">End your current session and clear all tokens.</p>

      <div x-show="$store.auth.isAuthenticated">
        <button
          @click="$store.auth.logout(); window.location.href = '/auth/login';"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm text-red-400 border border-red-800/50 rounded-lg hover:bg-red-900/20 transition-colors cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          Sign Out
        </button>
      </div>

      <div x-show="!$store.auth.isAuthenticated" class="text-xs text-gray-500">
        You are not signed in.
      </div>
    </div>

    <div class="h-6"></div>
  </div>
</DashboardLayout>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('passwordChanger', () => {
      const { getAuthStore } = (window as any).getAlpineStore();

      return {
        currentPassword: '',
        newPassword: '',
        confirmPassword: '',
        loading: false,
        error: null,
        success: false,

        async handleChangePassword() {
          // Validate
          if (this.newPassword !== this.confirmPassword) {
            this.error = 'New passwords do not match.';
            this.success = false;
            return;
          }
          if (this.newPassword.length < 8) {
            this.error = 'New password must be at least 8 characters.';
            this.success = false;
            return;
          }
          if (this.currentPassword.length < 1) {
            this.error = 'Please enter your current password.';
            this.success = false;
            return;
          }

          this.loading = true;
          this.error = null;
          this.success = false;

          try {
            const auth = getAuthStore();
            const result = await auth.changePassword(this.currentPassword, this.newPassword);

            if (result.success) {
              this.success = true;
              this.currentPassword = '';
              this.newPassword = '';
              this.confirmPassword = '';
            } else {
              this.error = result.error || 'Failed to change password.';
            }
          } catch (e) {
            this.error = 'Network error. Please try again.';
          }

          this.loading = false;
        },
      };
    });
  });
</script>
