---
/**
 * tradingweb/frontend/src/components/dashboard/Topbar.astro
 * Topbar — MarketPulse Header
 * =============================
 * Fixed header with page title, WebSocket connection status,
 * notification bell, and user menu with logout.
 */
---

<header
  class="fixed left-[228px] right-0 top-0 h-[52px] bg-surface-800 border-b border-surface-500 z-40 flex items-center justify-between px-5"
>
  <!-- ── Left: Title + Market Session + Connection Status ── -->
  <div class="flex items-center gap-3">
    <h1 class="font-display font-semibold text-white text-[15px]">Options Analysis</h1>

    <!-- Market Session Indicator -->
    <template x-if="marketSessions && sessionLabel">
      <div
        class="flex items-center gap-1.5 px-2 py-0.5 rounded-full"
        :class="sessionBg"
        :title="sessionLabel"
      >
        <div class="w-1.5 h-1.5 rounded-full" :class="sessionDotColor"></div>
        <span
          class="text-[10px] font-semibold tracking-wide"
          :class="sessionColor"
          x-text="sessionLabel"
        ></span>
      </div>
    </template>

    <!-- WebSocket Connection Status -->
    <div
      class="flex items-center gap-1.5 px-2 py-0.5 rounded-full"
      :class="connectionStatus === 'connected' ? 'bg-emerald-500/10' : connectionStatus === 'connecting' ? 'bg-sky-500/10' : 'bg-red-500/10'"
    >
      <div
        class="w-1.5 h-1.5 rounded-full"
        :class="[
          connectionStatus === 'connected' ? 'bg-emerald-400 live-dot' : '',
          connectionStatus === 'connecting' ? 'bg-sky-400 connect-pulse' : '',
          connectionStatus === 'disconnected' || connectionStatus === 'error' ? 'bg-red-400' : ''
        ]"
      ></div>
      <span
        class="text-[10px] font-semibold tracking-wide"
        :class="connectionColor"
        x-text="connectionLabel"
      ></span>
    </div>
  </div>

  <!-- ── Right: Actions ── -->
  <div class="flex items-center gap-2">

    <!-- Dark mode toggle -->
    <button
      @click="darkMode = !darkMode"
      class="w-8 h-8 rounded-lg bg-surface-600 border border-surface-200 flex items-center justify-center text-gray-400 hover:text-white hover:border-surface-100 transition-all"
      :aria-label="darkMode ? 'Light mode' : 'Dark mode'"
    >
      <svg x-show="darkMode" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <svg x-show="!darkMode" x-cloak class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>

    <!-- Notifications bell -->
    <div class="relative" x-data="{ open: false }">
      <button
        @click="open = !open"
        @click.outside="open = false"
        class="relative w-8 h-8 rounded-lg bg-surface-600 border border-surface-200 flex items-center justify-center text-gray-400 hover:text-white hover:border-surface-100 transition-all"
        aria-label="Notifications"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
      </button>
      <div
        x-show="open"
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 scale-95 -translate-y-1"
        x-transition:enter-end="opacity-100 scale-100 translate-y-0"
        x-transition:leave="transition ease-in duration-100"
        x-transition:leave-start="opacity-100 scale-100 translate-y-0"
        x-transition:leave-end="opacity-0 scale-95 -translate-y-1"
        x-cloak
        class="absolute right-0 top-full mt-2 w-72 bg-surface-800 border border-surface-500 rounded-xl shadow-2xl z-50"
      >
        <div class="p-3 border-b border-surface-500">
          <p class="text-xs font-semibold text-gray-300">Notifications</p>
        </div>
        <div class="p-3">
          <p class="text-xs text-gray-500 text-center py-4">No new notifications</p>
        </div>
      </div>
    </div>

    <!-- ── Auth: NOT signed in ── -->
    <template x-if="!$store.auth.isAuthenticated">
      <a
        href="/auth/login"
        class="ml-1 px-3 py-1.5 text-xs font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors no-underline"
      >
        Sign In
      </a>
    </template>

    <!-- ── Auth: signed in — user menu ── -->
    <template x-if="$store.auth.isAuthenticated">
      <div class="flex items-center gap-2 ml-1">
        <!-- Profile link -->
        <a href="/profile" title="Profile"
          class="w-8 h-8 rounded-lg bg-surface-600 border border-surface-200 flex items-center justify-center text-gray-400 hover:text-white hover:border-surface-100 transition-all no-underline"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
        <!-- Settings link -->
        <a href="/settings" title="Settings"
          class="w-8 h-8 rounded-lg bg-surface-600 border border-surface-200 flex items-center justify-center text-gray-400 hover:text-white hover:border-surface-100 transition-all no-underline"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.604.852.997 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
        </a>
        <!-- Logout button (always visible) -->
        <button
          @click="$store.auth.logout(); window.location.href = '/auth/login';"
          title="Sign Out"
          class="w-8 h-8 rounded-lg bg-surface-600 border border-surface-200 flex items-center justify-center text-gray-400 hover:text-red-400 hover:border-red-800/50 transition-all"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        </button>
        <!-- Avatar -->
        <div
          class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white font-display font-semibold text-[10px]"
          :title="$store.auth.username"
          x-text="$store.auth.username ? $store.auth.username.substring(0, 2).toUpperCase() : '??'"
        ></div>
      </div>
    </template>
  </div>
</header>
