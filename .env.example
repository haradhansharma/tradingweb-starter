# WebTrading Options Intelligence - Environment Configuration
# Copy this to .env and fill in your values

# Django
SECRET_KEY=your-django-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Binance API (Optional - only needed for private endpoints)
# Public endpoints don't require API keys
T_BINANCE_API_KEY=
T_BINANCE_API_SECRET=

# Database (PostgreSQL for production)
# DATABASE_URL=postgres://user:password@localhost:5432/webtrading