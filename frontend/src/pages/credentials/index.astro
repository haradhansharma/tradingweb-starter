---
/**
 * Credentials Page — MarketPulse
 * ================================
 * Broker API credentials management.
 * Credentials are encrypted at rest.
 * Requires authentication (DashboardLayout handles guard).
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Credentials — MarketPulse">
  <div class="p-5 space-y-5 max-w-[900px]">
    <!-- Header -->
    <div>
      <h1 class="text-lg font-semibold text-white" style="font-family: 'Space Grotesk', sans-serif;">Broker API Credentials</h1>
      <p class="text-xs text-gray-500 mt-0.5">Manage your broker API keys. Credentials are encrypted at rest and only used for order placement.</p>
    </div>

    <!-- Broker Credentials Card -->
    <div class="bg-[#1a1d27] border border-[#2a2d3a] rounded-xl p-5" x-data="credentialManager()">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-sm font-semibold text-gray-200" style="font-family: 'Space Grotesk', sans-serif;">
            API Keys
          </h2>
          <p class="text-xs text-gray-500 mt-0.5">Encrypted at rest. Only used for order placement.</p>
        </div>
        <button
          x-show="$store.auth.isAuthenticated"
          @click="showForm = !showForm"
          class="px-3 py-1.5 text-xs font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors"
        >
          <span x-show="!showForm">+ Add Credential</span>
          <span x-show="showForm">Cancel</span>
        </button>
      </div>

      <!-- Add Credential Form -->
      <div x-show="showForm && $store.auth.isAuthenticated" x-transition class="mb-4 p-4 bg-[#0f1117] rounded-lg border border-[#2a2d3a]">
        <form @submit.prevent="saveCredential()">
          <div class="grid grid-cols-2 gap-3 mb-3">
            <div>
              <label class="block text-xs text-gray-400 mb-1">Broker</label>
              <select x-model="form.broker" class="w-full px-2.5 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500">
                <option value="binance">Binance</option>
              </select>
            </div>
            <div>
              <label class="block text-xs text-gray-400 mb-1">Label</label>
              <input type="text" x-model="form.label" placeholder="e.g. Main Account"
                class="w-full px-2.5 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500">
            </div>
          </div>
          <div class="mb-3">
            <label class="block text-xs text-gray-400 mb-1">API Key</label>
            <input type="text" x-model="form.api_key" placeholder="Enter your API key" required
              class="w-full px-2.5 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500 font-mono">
          </div>
          <div class="mb-3">
            <label class="block text-xs text-gray-400 mb-1">API Secret</label>
            <input type="password" x-model="form.api_secret" placeholder="Enter your API secret" required
              class="w-full px-2.5 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500 font-mono">
          </div>
          <div class="flex items-center gap-4">
            <label class="flex items-center gap-2 cursor-pointer text-xs text-gray-400">
              <input type="checkbox" x-model="form.is_testnet" class="w-3 h-3 rounded accent-blue-500">
              Testnet
            </label>
            <button
              type="submit"
              :disabled="saving"
              class="ml-auto px-4 py-1.5 text-xs font-medium bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 text-white rounded-lg transition-colors"
            >
              <span x-show="!saving">Save Credentials</span>
              <span x-show="saving">Saving...</span>
            </button>
          </div>
        </form>
        <div x-show="formError" x-text="formError" class="mt-2 text-xs text-red-400"></div>
        <div x-show="success" x-transition class="mt-2 text-xs text-emerald-400">Credential saved successfully</div>
      </div>

      <!-- Not signed in -->
      <div x-show="!$store.auth.isAuthenticated" class="text-center py-6 text-gray-500 text-sm">
        <p>Please <a href="/auth/login" class="text-blue-400 hover:text-blue-300 no-underline">sign in</a> to manage credentials.</p>
      </div>

      <!-- Empty state -->
      <div x-show="$store.auth.isAuthenticated && credentials.length === 0 && !showForm" class="text-center py-8 text-gray-500">
        <svg class="w-8 h-8 mx-auto mb-2 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
        </svg>
        <p class="text-sm">No broker credentials stored.</p>
        <p class="text-xs mt-1">Add your broker API keys to enable order placement.</p>
      </div>

      <!-- Credentials table -->
      <div x-show="$store.auth.isAuthenticated && credentials.length > 0">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-xs text-gray-500 uppercase tracking-wider">
              <th class="pb-2">Broker</th>
              <th class="pb-2">Label</th>
              <th class="pb-2">Env</th>
              <th class="pb-2">Status</th>
              <th class="pb-2">Added</th>
              <th class="pb-2"></th>
            </tr>
          </thead>
          <tbody>
            <template x-for="cred in credentials" :key="cred.id">
              <tr class="border-t border-[#1f2937]">
                <td class="py-2.5 font-medium text-gray-200" x-text="cred.broker"></td>
                <td class="py-2.5 text-gray-400" x-text="cred.label || '—'"></td>
                <td class="py-2.5">
                  <span x-show="cred.is_testnet" class="text-xs px-2 py-0.5 rounded bg-blue-900/50 text-blue-400">Testnet</span>
                  <span x-show="!cred.is_testnet" class="text-xs px-2 py-0.5 rounded bg-emerald-900/50 text-emerald-400">Live</span>
                </td>
                <td class="py-2.5">
                  <span :class="cred.is_active ? 'text-emerald-400' : 'text-red-400'" class="text-xs font-medium"
                    x-text="cred.is_active ? 'Active' : 'Inactive'"></span>
                </td>
                <td class="py-2.5 text-gray-500 text-xs" x-text="cred.created_at ? new Date(cred.created_at).toLocaleDateString() : '—'"></td>
                <td class="py-2.5">
                  <button
                    @click="deleteCredential(cred.id)"
                    class="text-xs text-red-400 hover:text-red-300 transition-colors"
                  >
                    Delete
                  </button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Security Info Box -->
    <div class="bg-[#0f1117] border border-[#2a2d3a] rounded-xl p-4 flex items-start gap-3">
      <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      <div>
        <p class="text-xs font-medium text-gray-300">Security Information</p>
        <p class="text-[11px] text-gray-500 mt-0.5">All API keys and secrets are encrypted using AES-128-CBC before storage. They are never transmitted in plain text and can only be decrypted by the server. Public market data streams do not require personal API keys.</p>
      </div>
    </div>

    <!-- Quick links -->
    <div class="flex gap-3">
      <a href="/profile" class="flex items-center gap-2 px-3 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-xs text-gray-300 hover:text-white hover:border-surface-400 transition-all no-underline">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        Profile
      </a>
      <a href="/settings" class="flex items-center gap-2 px-3 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-xs text-gray-300 hover:text-white hover:border-surface-400 transition-all no-underline">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.604.852.997 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
        Change Password
      </a>
    </div>

    <div class="h-6"></div>
  </div>
</DashboardLayout>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('credentialManager', () => {
      const { getAuthStore } = (window as any).getAlpineStore();

      return {
        showForm: false,
        saving: false,
        formError: null,
        success: false,
        _successTimer: null as any,
        credentials: [] as any[],

        form: {
          broker: 'binance',
          label: '',
          api_key: '',
          api_secret: '',
          is_testnet: false,
        },

        init() {
          this.loadCredentials();
        },

        async loadCredentials() {
          try {
            const auth = getAuthStore();
            this.credentials = await auth.fetchCredentials();
          } catch (e) {
            console.error('[Credentials] Failed to load:', e);
            this.credentials = [];
          }
        },

        async saveCredential() {
          if (!this.form.api_key || !this.form.api_secret) {
            this.formError = 'API Key and Secret are required.';
            return;
          }

          this.saving = true;
          this.formError = null;
          this.success = false;

          try {
            const auth = getAuthStore();
            const result = await auth.saveCredential(this.form);

            if (result.success) {
              this.showForm = false;
              this.form = { broker: 'binance', label: '', api_key: '', api_secret: '', is_testnet: false };
              await this.loadCredentials();
              this.success = true;
              if (this._successTimer) clearTimeout(this._successTimer);
              this._successTimer = setTimeout(() => { this.success = false; }, 2500);
            } else {
              this.formError = result.error || 'Failed to save credentials.';
            }
          } catch (e) {
            this.formError = 'Network error. Please try again.';
          }

          this.saving = false;
        },

        async deleteCredential(id: number) {
          if (!confirm('Delete this credential? This action cannot be undone.')) return;

          try {
            const auth = getAuthStore();
            const ok = await auth.deleteCredential(id);
            if (ok) {
              await this.loadCredentials();
            } else {
              this.formError = 'Failed to delete credential.';
            }
          } catch (e) {
            this.formError = 'Network error. Please try again.';
          }
        },
      };
    });
  });
</script>
