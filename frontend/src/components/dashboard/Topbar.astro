---
/**
 * tradingweb/frontend/src/components/dashboard/Topbar.astro
 * Topbar — MarketPulse Header
 * =============================
 * Fixed header with page title, WebSocket connection status,
 * search input, dark mode toggle, notification bell, and auth controls.
 * Reads reactive state from Alpine.js dashboard + auth store.
 */
---

<header
  class="fixed left-[228px] right-0 top-0 h-[52px] bg-surface-800 border-b border-surface-500 z-40 flex items-center justify-between px-5"
>
  <!-- ── Left: Title + Market Session + Connection Status ── -->
  <div class="flex items-center gap-3">
    <h1 class="font-display font-semibold text-white text-[15px]">Options Analysis</h1>

    <!-- Market Session Indicator -->
    <template x-if="marketSessions && sessionLabel">
      <div
        class="flex items-center gap-1.5 px-2 py-0.5 rounded-full"
        :class="sessionBg"
        :title="sessionLabel"
      >
        <div class="w-1.5 h-1.5 rounded-full" :class="sessionDotColor"></div>
        <span
          class="text-[10px] font-semibold tracking-wide"
          :class="sessionColor"
          x-text="sessionLabel"
        ></span>
      </div>
    </template>

    <!-- WebSocket Connection Status -->
    <div
      class="flex items-center gap-1.5 px-2 py-0.5 rounded-full"
      :class="connectionStatus === 'connected' ? 'bg-emerald-500/10' : connectionStatus === 'connecting' ? 'bg-sky-500/10' : 'bg-red-500/10'"
    >
      <div
        class="w-1.5 h-1.5 rounded-full"
        :class="[
          connectionStatus === 'connected' ? 'bg-emerald-400 live-dot' : '',
          connectionStatus === 'connecting' ? 'bg-sky-400 connect-pulse' : '',
          connectionStatus === 'disconnected' || connectionStatus === 'error' ? 'bg-red-400' : ''
        ]"
      ></div>
      <span
        class="text-[10px] font-semibold tracking-wide"
        :class="connectionColor"
        x-text="connectionLabel"
      ></span>
    </div>
  </div>

  <!-- ── Right: Search + Actions ── -->
  <div class="flex items-center gap-2">
    <!-- Search -->
    <div class="relative">
      <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        placeholder="Search..."
        class="bg-surface-600 border border-surface-200 rounded-lg pl-8 pr-3 py-1.5 text-[13px] text-gray-300 placeholder-gray-500 w-40 focus:outline-none focus:border-emerald-500/40 focus:ring-1 focus:ring-emerald-500/15 transition-all"
      >
    </div>

    <!-- Dark mode toggle -->
    <button
      @click="darkMode = !darkMode"
      class="w-8 h-8 rounded-lg bg-surface-600 border border-surface-200 flex items-center justify-center text-gray-400 hover:text-white hover:border-surface-100 transition-all"
      :aria-label="darkMode ? 'Light mode' : 'Dark mode'"
    >
      <!-- Sun icon (shown in dark mode) -->
      <svg x-show="darkMode" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <!-- Moon icon (shown in light mode) -->
      <svg x-show="!darkMode" x-cloak class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>

    <!-- Notifications -->
    <button
      class="relative w-8 h-8 rounded-lg bg-surface-600 border border-surface-200 flex items-center justify-center text-gray-400 hover:text-white hover:border-surface-100 transition-all"
      aria-label="Notifications"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
      </svg>
      <span class="absolute -top-0.5 -right-0.5 w-3.5 h-3.5 bg-red-500 rounded-full text-[8px] font-bold text-white flex items-center justify-center">3</span>
    </button>

    <!-- Auth Controls (topbar) -->
    <!-- Logged out: Sign In button -->
    <template x-if="!auth.isAuthenticated">
      <a
        href="/auth/login"
        class="ml-1 px-3 py-1.5 text-xs font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors"
      >
        Sign In
      </a>
    </template>

    <!-- Logged in: User menu -->
    <template x-if="auth.isAuthenticated">
      <div class="flex items-center gap-2 ml-1">
        <!-- Settings link -->
        <a
          href="/settings"
          class="w-8 h-8 rounded-lg bg-surface-600 border border-surface-200 flex items-center justify-center text-gray-400 hover:text-white hover:border-surface-100 transition-all"
          title="Settings"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.6.852.997 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
        </a>

        <!-- Avatar with initials -->
        <div
          class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white font-display font-semibold text-[10px] cursor-pointer"
          :title="auth.username"
          x-text="auth.username ? auth.username.substring(0, 2).toUpperCase() : '??'"
        ></div>
      </div>
    </template>
  </div>
</header>
