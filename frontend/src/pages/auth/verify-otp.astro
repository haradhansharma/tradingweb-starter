---
/**
 * Verify OTP Page — MarketPulse
 * ==============================
 * 6-digit OTP verification page shown after registration.
 * User must enter the code sent to their email to activate their account.
 *
 * URL: /auth/verify-otp?username=<username>
 * Also accessible from login page if account is not verified.
 */
import AuthLayout from '../../layouts/AuthLayout.astro';
---

<AuthLayout title="Verify Email — MarketPulse">
  <div x-data="otpForm()" x-init="init()">
    <!-- Logo -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-blue-500/10 border border-blue-500/20 mb-4">
        <svg class="w-7 h-7 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M9 12l2 2 4-4"/>
          <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-blue-400" style="font-family: 'Space Grotesk', sans-serif;">
        Verify Your Email
      </h1>
      <p class="text-sm text-gray-500 mt-1">
        Enter the 6-digit code sent to your email
      </p>
    </div>

    <!-- Error -->
    <div
      x-show="error"
      x-transition
      class="mb-4 p-3 bg-red-900/30 border border-red-800 rounded-lg text-sm text-red-300"
      x-text="error"
    ></div>

    <!-- Success -->
    <div
      x-show="verified"
      x-transition
      class="mb-4 p-3 bg-emerald-900/30 border border-emerald-800 rounded-lg text-sm text-emerald-300"
    >
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Email verified! Redirecting to sign in...</span>
      </div>
    </div>

    <!-- OTP Input (6 individual digit boxes) -->
    <form x-show="!verified" @submit.prevent="handleVerify()">
      <div class="mb-6">
        <label class="block text-xs font-medium text-gray-400 uppercase tracking-wider mb-3">Verification Code</label>
        <div class="flex gap-2 justify-center">
          <template x-for="(digit, index) in digits" :key="index">
            <input
              type="text"
              inputmode="numeric"
              maxlength="1"
              :ref="'otp_' + index"
              :value="digit"
              @input="handleDigitInput($event, index)"
              @keydown="handleKeyDown($event, index)"
              @paste="handlePaste($event)"
              @focus="$event.target.select()"
              class="w-11 h-13 text-center text-lg font-bold bg-[#0f1117] border border-[#2a2d3a] rounded-lg text-gray-200 outline-none focus:border-blue-500 transition-colors"
              :class="error ? 'border-red-600' : ''"
            >
          </template>
        </div>
        <p class="text-[11px] text-gray-500 text-center mt-2">Enter the 6-digit code from your email</p>
      </div>

      <!-- Verify Button -->
      <button
        type="submit"
        :disabled="loading || !isCodeComplete"
        class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 disabled:opacity-40 disabled:cursor-not-allowed text-white text-sm font-semibold rounded-lg transition-colors"
      >
        <span x-show="!loading">Verify Code</span>
        <span x-show="loading" class="flex items-center justify-center gap-2">
          <svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="32" stroke-dashoffset="32" stroke-linecap="round"/>
          </svg>
          Verifying...
        </span>
      </button>

      <!-- Resend OTP -->
      <div class="mt-5 text-center">
        <template x-if="!resendCooldown">
          <button
            type="button"
            @click="handleResend()"
            :disabled="resendLoading"
            class="text-sm text-blue-400 hover:text-blue-300 disabled:opacity-40 transition-colors"
          >
            <span x-show="!resendLoading">Didn't receive the code? <span class="font-medium">Resend</span></span>
            <span x-show="resendLoading" class="flex items-center justify-center gap-1.5">
              <svg class="animate-spin w-3.5 h-3.5" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="32" stroke-dashoffset="32" stroke-linecap="round"/>
              </svg>
              Sending...
            </span>
          </button>
        </template>
        <template x-if="resendCooldown">
          <p class="text-sm text-gray-500">
            Resend available in <span class="text-blue-400 font-medium" x-text="resendCooldown"></span>s
          </p>
        </template>
      </div>
    </form>

    <!-- Footer -->
    <div class="mt-6 pt-5 border-t border-[#2a2d3a]">
      <p class="text-center text-sm text-gray-500">
        Already verified?
        <a href="/auth/login" class="text-blue-400 hover:text-blue-300 ml-1">Sign in</a>
      </p>
    </div>
  </div>
</AuthLayout>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('otpForm', () => {
      const { getAuthStore } = getAlpineStore();

      return {
        digits: ['', '', '', '', '', ''],
        loading: false,
        error: null,
        verified: false,
        resendLoading: false,
        resendCooldown: 0,
        username: '',
        cooldownTimer: null as ReturnType<typeof setInterval> | null,

        get isCodeComplete(): boolean {
          return this.digits.every(d => d !== '');
        },

        get code(): string {
          return this.digits.join('');
        },

        init() {
          // Get username from URL query parameter
          const params = new URLSearchParams(window.location.search);
          this.username = params.get('username') || '';

          // Focus first input
          this.$nextTick(() => {
            const firstInput = document.querySelector('input[inputmode="numeric"]') as HTMLInputElement;
            if (firstInput) firstInput.focus();
          });
        },

        handleDigitInput(event: Event, index: number) {
          const input = event.target as HTMLInputElement;
          const value = input.value.replace(/\D/g, '');

          if (value) {
            this.digits[index] = value.charAt(0);

            // Auto-focus next input
            if (index < 5) {
              const nextRef = this.$refs[`otp_${index + 1}`] as HTMLInputElement | HTMLInputElement[];
              const nextInput = Array.isArray(nextRef) ? nextRef[0] : nextRef;
              nextInput?.focus();
            }
          } else {
            this.digits[index] = '';
          }

          // Clear error when user types
          if (this.error) this.error = null;
        },

        handleKeyDown(event: KeyboardEvent, index: number) {
          // Backspace: clear current and focus previous
          if (event.key === 'Backspace' && !this.digits[index] && index > 0) {
            const prevRef = this.$refs[`otp_${index - 1}`] as HTMLInputElement | HTMLInputElement[];
            const prevInput = Array.isArray(prevRef) ? prevRef[0] : prevRef;
            prevInput?.focus();
            this.digits[index - 1] = '';
            event.preventDefault();
          }
        },

        handlePaste(event: ClipboardEvent) {
          event.preventDefault();
          const pastedData = (event.clipboardData?.getData('text') || '').replace(/\D/g, '').slice(0, 6);

          if (pastedData.length === 6) {
            this.digits = pastedData.split('');
            this.error = null;

            // Focus last input
            this.$nextTick(() => {
              const lastRef = this.$refs['otp_5'] as HTMLInputElement | HTMLInputElement[];
              const lastInput = Array.isArray(lastRef) ? lastRef[0] : lastRef;
              lastInput?.focus();
            });
          }
        },

        async handleVerify() {
          if (!this.isCodeComplete) return;
          if (!this.username) {
            this.error = 'Missing username. Please go to the login page.';
            return;
          }

          this.loading = true;
          this.error = null;

          const auth = getAuthStore();
          const result = await auth.verifyOtp(this.username, this.code);

          this.loading = false;

          if (result.success) {
            this.verified = true;
            setTimeout(() => { window.location.href = '/auth/login'; }, 2000);
          } else {
            this.error = result.message;
          }
        },

        async handleResend() {
          if (!this.username) return;

          this.resendLoading = true;
          this.error = null;

          const auth = getAuthStore();
          const result = await auth.resendOtp(this.username);

          this.resendLoading = false;

          if (result.success) {
            // Start cooldown timer (60 seconds)
            this.resendCooldown = 60;
            if (this.cooldownTimer) clearInterval(this.cooldownTimer);
            this.cooldownTimer = setInterval(() => {
              this.resendCooldown--;
              if (this.resendCooldown <= 0) {
                this.resendCooldown = 0;
                if (this.cooldownTimer) {
                  clearInterval(this.cooldownTimer);
                  this.cooldownTimer = null;
                }
              }
            }, 1000);
          } else {
            this.error = result.message;
          }
        },
      };
    });
  });
</script>
