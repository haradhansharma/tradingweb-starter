---
/**
 * Settings Page — MarketPulse
 * =============================
 * User profile + broker credentials management.
 * Requires authentication.
 */
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Settings — MarketPulse">
  <div class="p-5 space-y-5 max-w-[900px]">
    <!-- Header -->
    <div>
      <h1 class="text-lg font-semibold text-white" style="font-family: 'Space Grotesk', sans-serif;">Settings</h1>
      <p class="text-xs text-gray-500 mt-0.5">Manage your profile and broker credentials</p>
    </div>

    <!-- Profile Card -->
    <div class="bg-[#1a1d27] border border-[#2a2d3a] rounded-xl p-5">
      <h2 class="text-sm font-semibold text-gray-200 mb-4" style="font-family: 'Space Grotesk', sans-serif;">
        Profile
      </h2>

      <template x-if="auth.isAuthenticated">
        <div>
          <div class="grid grid-cols-2 gap-4 text-sm">
            <div>
              <span class="text-xs text-gray-500 uppercase tracking-wider">Username</span>
              <p class="text-gray-200 mt-0.5" x-text="auth.username"></p>
            </div>
            <div>
              <span class="text-xs text-gray-500 uppercase tracking-wider">Email</span>
              <p class="text-gray-200 mt-0.5" x-text="auth.user?.email || 'Not set'"></p>
            </div>
            <div>
              <span class="text-xs text-gray-500 uppercase tracking-wider">Risk Tolerance</span>
              <p class="text-gray-200 mt-0.5 capitalize" x-text="auth.user?.risk_tolerance || 'moderate'"></p>
            </div>
            <div>
              <span class="text-xs text-gray-500 uppercase tracking-wider">Verified</span>
              <p class="mt-0.5">
                <span
                  class="text-xs px-2 py-0.5 rounded"
                  :class="auth.user?.is_verified ? 'bg-emerald-900/50 text-emerald-400' : 'bg-amber-900/50 text-amber-400'"
                  x-text="auth.user?.is_verified ? 'Yes' : 'No'"
                ></span>
              </p>
            </div>
          </div>

          <!-- Notification Preferences -->
          <div class="mt-4 pt-4 border-t border-[#2a2d3a]">
            <h3 class="text-xs text-gray-500 uppercase tracking-wider mb-3">Notifications</h3>
            <div class="flex flex-col gap-2.5">
              <label class="flex items-center gap-2.5 cursor-pointer text-sm text-gray-300">
                <input type="checkbox" :checked="auth.user?.notify_strong_signals" disabled
                  class="w-3.5 h-3.5 rounded accent-blue-500">
                Strong Signals
              </label>
              <label class="flex items-center gap-2.5 cursor-pointer text-sm text-gray-300">
                <input type="checkbox" :checked="auth.user?.notify_whale_activity" disabled
                  class="w-3.5 h-3.5 rounded accent-blue-500">
                Whale Activity
              </label>
              <label class="flex items-center gap-2.5 cursor-pointer text-sm text-gray-300">
                <input type="checkbox" :checked="auth.user?.notify_market_shifts" disabled
                  class="w-3.5 h-3.5 rounded accent-blue-500">
                Market Shifts
              </label>
            </div>
          </div>

          <!-- Logout -->
          <div class="mt-4 pt-4 border-t border-[#2a2d3a] flex items-center gap-3">
            <button
              @click="auth.logout(); window.location.href = '/auth/login';"
              class="px-4 py-1.5 text-sm text-red-400 border border-red-800/50 rounded-lg hover:bg-red-900/20 transition-colors"
            >
              Sign Out
            </button>
          </div>
        </div>
      </template>

      <template x-if="!auth.isAuthenticated">
        <div class="text-center py-6 text-gray-500 text-sm">
          <p>Please <a href="/auth/login" class="text-blue-400 hover:text-blue-300">sign in</a> to view your settings.</p>
        </div>
      </template>
    </div>

    <!-- Change Password Card -->
    <div class="bg-[#1a1d27] border border-[#2a2d3a] rounded-xl p-5" x-data="passwordChanger()">
      <h2 class="text-sm font-semibold text-gray-200 mb-4" style="font-family: 'Space Grotesk', sans-serif;">
        Change Password
      </h2>

      <template x-if="auth.isAuthenticated">
        <div>
          <form @submit.prevent="handleChangePassword()">
            <div class="mb-3">
              <label class="block text-xs text-gray-400 mb-1">Current Password</label>
              <input type="password" x-model="currentPassword" required
                class="w-full px-2.5 py-2 bg-[#0f1117] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500"
                placeholder="Enter current password">
            </div>
            <div class="mb-3">
              <label class="block text-xs text-gray-400 mb-1">New Password</label>
              <input type="password" x-model="newPassword" required minlength="8"
                class="w-full px-2.5 py-2 bg-[#0f1117] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500"
                placeholder="At least 8 characters">
            </div>
            <div class="mb-4">
              <label class="block text-xs text-gray-400 mb-1">Confirm New Password</label>
              <input type="password" x-model="confirmPassword" required minlength="8"
                class="w-full px-2.5 py-2 bg-[#0f1117] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500"
                placeholder="Confirm new password">
            </div>

            <div x-show="error" x-text="error" class="mb-3 text-xs text-red-400"></div>
            <div x-show="success" class="mb-3 text-xs text-emerald-400">
              Password changed successfully!
            </div>

            <button
              type="submit"
              :disabled="loading"
              class="px-4 py-1.5 text-xs font-medium bg-blue-600 hover:bg-blue-700 disabled:opacity-50 text-white rounded-lg transition-colors"
            >
              <span x-show="!loading">Update Password</span>
              <span x-show="loading">Updating...</span>
            </button>
          </form>
        </div>
      </template>

      <template x-if="!auth.isAuthenticated">
        <div class="text-center py-4 text-gray-500 text-sm">
          <p>Please <a href="/auth/login" class="text-blue-400 hover:text-blue-300">sign in</a> to change your password.</p>
        </div>
      </template>
    </div>

    <!-- Broker Credentials Card -->
    <div class="bg-[#1a1d27] border border-[#2a2d3a] rounded-xl p-5" x-data="credentialManager()">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-sm font-semibold text-gray-200" style="font-family: 'Space Grotesk', sans-serif;">
            Broker API Credentials
          </h2>
          <p class="text-xs text-gray-500 mt-0.5">Encrypted at rest. Only used for order placement.</p>
        </div>
        <button
          @click="showForm = !showForm"
          class="px-3 py-1.5 text-xs font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors"
        >
          <span x-show="!showForm">+ Add</span>
          <span x-show="showForm">Cancel</span>
        </button>
      </div>

      <!-- Add Credential Form -->
      <div x-show="showForm" x-transition class="mb-4 p-4 bg-[#0f1117] rounded-lg border border-[#2a2d3a]">
        <div class="grid grid-cols-2 gap-3 mb-3">
          <div>
            <label class="block text-xs text-gray-400 mb-1">Broker</label>
            <select x-model="form.broker" class="w-full px-2.5 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500">
              <option value="binance">Binance</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-gray-400 mb-1">Label</label>
            <input type="text" x-model="form.label" placeholder="e.g. Main Account"
              class="w-full px-2.5 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500">
          </div>
        </div>
        <div class="mb-3">
          <label class="block text-xs text-gray-400 mb-1">API Key</label>
          <input type="text" x-model="form.api_key" placeholder="Enter your API key"
            class="w-full px-2.5 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500 font-mono">
        </div>
        <div class="mb-3">
          <label class="block text-xs text-gray-400 mb-1">API Secret</label>
          <input type="password" x-model="form.api_secret" placeholder="Enter your API secret"
            class="w-full px-2.5 py-2 bg-[#1a1d27] border border-[#2a2d3a] rounded-lg text-sm text-gray-200 outline-none focus:border-blue-500 font-mono">
        </div>
        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2 cursor-pointer text-xs text-gray-400">
            <input type="checkbox" x-model="form.is_testnet" class="w-3 h-3 rounded accent-blue-500">
            Testnet
          </label>
          <button
            @click="saveCredential()"
            :disabled="saving"
            class="ml-auto px-4 py-1.5 text-xs font-medium bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 text-white rounded-lg transition-colors"
          >
            <span x-show="!saving">Save Credentials</span>
            <span x-show="saving">Saving...</span>
          </button>
        </div>
        <div x-show="formError" x-text="formError" class="mt-2 text-xs text-red-400"></div>
      </div>

      <!-- Credentials List -->
      <div x-show="!auth.isAuthenticated" class="text-center py-6 text-gray-500 text-sm">
        <p>Please <a href="/auth/login" class="text-blue-400 hover:text-blue-300">sign in</a> to manage credentials.</p>
      </div>

      <div x-show="auth.isAuthenticated && credentials.length === 0" class="text-center py-6 text-gray-500 text-sm">
        <p>No broker credentials stored. Add one to enable order placement.</p>
      </div>

      <table x-show="auth.isAuthenticated && credentials.length > 0" class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-gray-500 uppercase tracking-wider">
            <th class="pb-2">Broker</th>
            <th class="pb-2">Label</th>
            <th class="pb-2">Env</th>
            <th class="pb-2">Status</th>
            <th class="pb-2">Added</th>
            <th class="pb-2"></th>
          </tr>
        </thead>
        <tbody>
          <template x-for="cred in credentials" :key="cred.id">
            <tr class="border-t border-[#1f2937]">
              <td class="py-2.5 font-medium text-gray-200" x-text="cred.broker"></td>
              <td class="py-2.5 text-gray-400" x-text="cred.label || '—'"></td>
              <td class="py-2.5">
                <span x-show="cred.is_testnet" class="text-xs px-2 py-0.5 rounded bg-blue-900/50 text-blue-400">Testnet</span>
                <span x-show="!cred.is_testnet" class="text-xs px-2 py-0.5 rounded bg-emerald-900/50 text-emerald-400">Live</span>
              </td>
              <td class="py-2.5">
                <span :class="cred.is_active ? 'text-emerald-400' : 'text-red-400'" class="text-xs font-medium"
                  x-text="cred.is_active ? 'Active' : 'Inactive'"></span>
              </td>
              <td class="py-2.5 text-gray-500 text-xs" x-text="cred.created_at ? new Date(cred.created_at).toLocaleDateString() : '—'"></td>
              <td class="py-2.5">
                <button
                  @click="deleteCredential(cred.id)"
                  class="text-xs text-red-400 hover:text-red-300 transition-colors"
                >
                  Delete
                </button>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <div class="h-6"></div>
  </div>
</DashboardLayout>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('passwordChanger', () => {
      const { getAuthStore } = (window as any).getAlpineStore();

      return {
        currentPassword: '',
        newPassword: '',
        confirmPassword: '',
        loading: false,
        error: null,
        success: false,

        async handleChangePassword() {
          if (this.newPassword !== this.confirmPassword) {
            this.error = 'Passwords do not match.';
            this.success = false;
            return;
          }
          if (this.newPassword.length < 8) {
            this.error = 'New password must be at least 8 characters.';
            this.success = false;
            return;
          }

          this.loading = true;
          this.error = null;
          this.success = false;

          const auth = getAuthStore();
          const result = await auth.changePassword(this.currentPassword, this.newPassword);

          this.loading = false;

          if (result.success) {
            this.success = true;
            this.currentPassword = '';
            this.newPassword = '';
            this.confirmPassword = '';
          } else {
            this.error = result.error || 'Failed to change password.';
          }
        },
      };
    });

    Alpine.data('credentialManager', () => {
      const { getAuthStore } = (window as any).getAlpineStore();

      return {
        showForm: false,
        saving: false,
        formError: null,
        credentials: [] as any[],

        form: {
          broker: 'binance',
          label: '',
          api_key: '',
          api_secret: '',
          is_testnet: false,
        },

        init() {
          this.loadCredentials();
        },

        async loadCredentials() {
          const auth = getAuthStore();
          this.credentials = await auth.fetchCredentials();
        },

        async saveCredential() {
          this.saving = true;
          this.formError = null;

          const auth = getAuthStore();
          const result = await auth.saveCredential(this.form);

          if (result.success) {
            this.showForm = false;
            this.form = { broker: 'binance', label: '', api_key: '', api_secret: '', is_testnet: false };
            await this.loadCredentials();
          } else {
            this.formError = result.error || 'Failed to save';
          }

          this.saving = false;
        },

        async deleteCredential(id: number) {
          if (!confirm('Delete this credential?')) return;

          const auth = getAuthStore();
          const ok = await auth.deleteCredential(id);
          if (ok) {
            await this.loadCredentials();
          }
        },
      };
    });
  });
</script>
