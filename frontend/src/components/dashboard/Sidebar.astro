---
/**
 * tradingweb/frontend/src/components/dashboard/Sidebar.astro
 * Sidebar — MarketPulse Navigation
 * ===================================
 * Fixed left sidebar with branding, navigation sections,
 * and user profile. Reads reactive state from the Alpine.js
 * dashboard store (activeNav).
 */
---

<aside
  class="fixed left-0 top-0 bottom-0 w-[228px] bg-surface-800 border-r border-surface-500 z-50 flex flex-col"
  role="navigation"
  aria-label="Main navigation"
>
  <!-- ── Branding ── -->
  <div class="h-14 flex items-center px-5 border-b border-surface-500 shrink-0">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-emerald-500/15 flex items-center justify-center">
        <svg class="w-[18px] h-[18px] text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
          <polyline points="16 7 22 7 22 13"></polyline>
        </svg>
      </div>
      <span class="font-display font-semibold text-white text-[17px] tracking-tight">MarketPulse</span>
    </div>
  </div>

  <!-- ── Navigation Sections ── -->
  <nav class="flex-1 py-4 px-2.5 space-y-0.5 overflow-y-auto dash-scroll">

    <!-- ── Broker Selector (button row) ── -->
    <div class="px-3 mb-2">
      <p class="text-[10px] uppercase tracking-[.12em] text-gray-500 font-semibold mb-1.5">Broker</p>
      <div class="flex gap-1.5">
        <template x-for="b in availableBrokers" :key="b.id">
          <button
            @click="switchBroker(b.id)"
            :class="b.id === activeBroker
              ? 'bg-emerald-500/15 border-emerald-500/40 text-emerald-400'
              : 'bg-surface-700 border-surface-500 text-gray-400 hover:border-surface-400 hover:text-gray-300'"
            class="flex-1 text-[11px] font-medium border rounded-lg px-2.5 py-1.5 transition-all text-center truncate"
            x-text="b.display_name"
          ></button>
        </template>
      </div>
    </div>

    <!-- Overview section -->
    <p class="px-3 mb-2 text-[10px] uppercase tracking-[.12em] text-gray-500 font-semibold">Overview</p>
    <template x-for="item in navItems" :key="item.id">
      <button
        @click="activeNav = item.id"
        :class="activeNav === item.id ? 'active' : ''"
        class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-r-lg text-[13px] text-gray-400"
        :aria-current="activeNav === item.id ? 'page' : false"
      >
        <span class="w-[18px] h-[18px] flex items-center justify-center" x-html="item.icon"></span>
        <span x-text="item.label"></span>
        <span
          x-show="item.badge"
          x-text="item.badge"
          class="ml-auto bg-emerald-500/15 text-emerald-400 text-[10px] font-semibold px-1.5 py-0.5 rounded-full leading-none"
        ></span>
      </button>
    </template>

    <!-- System section -->
    <div class="pt-4">
      <p class="px-3 mb-2 text-[10px] uppercase tracking-[.12em] text-gray-500 font-semibold">System</p>
    </div>
    <template x-for="item in sysItems" :key="item.id">
      <button
        @click="activeNav = item.id"
        :class="activeNav === item.id ? 'active' : ''"
        class="nav-item w-full flex items-center gap-3 px-3 py-2.5 rounded-r-lg text-[13px] text-gray-400"
      >
        <span class="w-[18px] h-[18px] flex items-center justify-center" x-html="item.icon"></span>
        <span x-text="item.label"></span>
        <span
          x-show="item.badge"
          x-text="item.badge"
          class="ml-auto bg-emerald-500/15 text-emerald-400 text-[10px] font-semibold px-1.5 py-0.5 rounded-full leading-none"
        ></span>
      </button>
    </template>
  </nav>

  <!-- ── User Profile ── -->
  <div class="p-4 border-t border-surface-500 shrink-0">
    <template x-if="auth.isAuthenticated">
      <a href="/settings" class="flex items-center gap-3 group cursor-pointer">
        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white font-display font-semibold text-xs"
          x-text="auth.username ? auth.username.substring(0, 2).toUpperCase() : '??'"
        ></div>
        <div class="flex-1 min-w-0">
          <p class="text-[13px] font-medium text-gray-200 truncate group-hover:text-white transition-colors" x-text="auth.username || 'User'"></p>
          <p class="text-[11px] text-gray-500 truncate">Settings &rarr;</p>
        </div>
      </a>
    </template>
    <template x-if="!auth.isAuthenticated">
      <a href="/auth/login" class="flex items-center gap-3 group cursor-pointer">
        <div class="w-9 h-9 rounded-full bg-surface-600 border border-surface-400 flex items-center justify-center text-gray-500">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-[13px] font-medium text-gray-400 group-hover:text-gray-200 transition-colors">Sign In</p>
          <p class="text-[11px] text-gray-500 truncate">Access your account</p>
        </div>
      </a>
    </template>
  </div>
</aside>
